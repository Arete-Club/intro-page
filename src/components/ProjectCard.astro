---
import { type Project, verifiedLink } from '../data/content';
interface Props { project: Project }
const { project } = Astro.props;
const href = verifiedLink(project.href);
const repository = href ? new URL(href).pathname.replace(/^\/|\/$/g, '') : null;
---

<article class="project-card section-grid" data-project={project.name}>
  <div class="project-heading" data-reveal>
    <p class="project-category">{project.category}</p>
    <h3>{project.name}</h3>
  </div>
  <div class="project-body" data-reveal="detail">
    <p>{project.summary}</p>
    {(project.status || href) && <div class="project-links">
      {project.status && <span class="project-status">{project.status}</span>}
      {href && <a class="action-link" href={href} aria-label={`GitHub repository ${repository}`}><span class="record">{repository}</span> <span class="link-arrow" aria-hidden="true">↗</span></a>}
    </div>}
  </div>
</article>
