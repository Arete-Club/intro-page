---
interface Props { showContact: boolean }
const { showContact } = Astro.props;
---

<section id="top" class="ocean" aria-labelledby="hero-title" data-scene="static">
  <div class="ocean-stage">
    <div class="ocean-fallback" aria-hidden="true"></div>
    <div class="ocean-canvas" aria-hidden="true"></div>
    <div class="ocean-shade" aria-hidden="true"></div>
    <header class="site-header wrap">
      <a class="wordmark" href="#top" aria-label="Arete Club 처음으로">Arete Club<span class="wordmark-dot" aria-hidden="true">.</span></a>
      <nav aria-label="주요 메뉴">
        <a href="#about">About</a>
        <a href="#research">Research</a>
        <a href="#projects">Projects <span aria-hidden="true">↗</span></a>
        {showContact && <a href="#contact">Contact</a>}
      </nav>
    </header>

    <div class="scene-copy hero-copy" data-copy="hero">
      <div class="wrap">
        <h1 id="hero-title"><span class="hero-brand mono">Arete Club</span> <span class="hero-title">Beyond the Surface.</span></h1>
        <p class="hero-sub">Independent AI Research &amp; Development</p>
      </div>
    </div>
    <div class="scene-copy statement descent-copy" data-copy="descent">
      <div class="wrap">
        <p class="statement-lead">Explore the Unknown.</p>
        <p class="statement-sub">We explore the frontiers of intelligence.</p>
      </div>
    </div>
    <div class="scene-copy statement abyss-copy" data-copy="abyss">
      <div class="wrap">
        <p class="statement-lead">Curiosity drives discovery.</p>
        <p class="statement-lead statement-echo">Excellence shapes what comes next.</p>
      </div>
    </div>
    <div class="scroll-cue mono" data-copy="cue" aria-hidden="true"><span>Scroll to Explore</span><span class="scroll-line"></span></div>
  </div>
</section>
