---
import '../styles/global.css';
import OceanExperience from '../components/OceanExperience.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { channels, projects, research, verifiedLink } from '../data/content';

const github = verifiedLink(channels.github);
const description = 'An independent AI research and development community exploring unknown possibilities and building practical, verifiable AI systems.';
const title = 'Arete Club — Independent AI Research & Development';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#061521" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Arete Club" />
    <meta property="og:type" content="website" />
    <title>{title}</title>
    <!-- Choose the scroll layout before first paint so anchors do not shift. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#about">Skip to content</a>
    <main>
      <OceanExperience showContact={Boolean(github || channels.email)} />

      <div class="deep-content">
        <section id="about" class="section wrap about" aria-labelledby="about-title">
          <div class="section-label">About</div>
          <div class="section-grid">
            <div data-reveal><p class="small-label">Explore deeply. Build with care.</p><h2 id="about-title">A Pursuit of<br />Excellence.</h2></div>
            <div class="about-copy" data-reveal="detail">
              <p>Arete takes its name from the ancient Greek idea of excellence. We believe technology achieves excellence when it serves its purpose with clarity and care.</p>
              <p>The ocean is close to us, yet much of its depth remains unknown. We approach AI with the same curiosity: understanding today's technology more deeply and exploring possibilities still beyond our reach.</p>
              <div class="values"><span>Exploration</span><span>Excellence</span><span>Engineering</span></div>
            </div>
          </div>
        </section>

        <section id="research" class="section wrap research" aria-labelledby="research-title">
          <div class="section-label">Research</div>
          <div class="research-heading section-grid"><h2 id="research-title" data-reveal>What We Explore.</h2><p data-reveal="detail">We explore how to make intelligent systems more reliable, efficient, and aligned with human intent.</p></div>
          <p class="small-label research-caption">Our research interests</p>
          <div class="research-list">
            {research.map((area) => <article class="research-row section-grid">
              <h3 data-reveal>{area.title}</h3><p data-reveal="detail">{area.description}</p>
            </article>)}
          </div>
        </section>

        <section id="projects" class="section wrap projects" aria-labelledby="projects-title">
          <div class="section-label">Projects</div>
          <div class="projects-heading section-grid"><h2 id="projects-title" data-reveal>Ideas, into practice.</h2><p data-reveal="detail">Turning exploration into working projects.</p></div>
          <div class="project-grid">{projects.map((project) => <ProjectCard project={project} />)}</div>
        </section>

        {github && <section id="exploration" class="section wrap exploration" aria-labelledby="exploration-title">
          <div class="section-label"></div>
          <div class="exploration-body section-grid">
            <h2 id="exploration-title" data-reveal>Open Exploration.</h2>
            <div data-reveal="detail">
              <p>Explore our public projects and research on GitHub.</p>
              <a class="work-link action-link" href={github}>Arete Club on GitHub <span class="link-arrow" aria-hidden="true">↗</span></a>
            </div>
          </div>
        </section>}

        <footer id="contact" class="footer wrap" aria-label="Contact">
          <div class="footer-top"><a href="#top" class="wordmark">Arete Club<span class="wordmark-dot" aria-hidden="true">.</span></a><p>Curiosity drives exploration.<br />Evidence guides progress.</p></div>
          <div class="footer-bottom"><span>© Arete Club</span>
            {(github || channels.email) && <div class="official-links">{github && <a href={github}>GitHub ↗</a>}{channels.email && <a href={`mailto:${channels.email}`}>Contact ↗</a>}</div>}
            <a class="back-top" href="#top">Back to surface <span aria-hidden="true">↑</span></a>
          </div>
        </footer>
      </div>
    </main>
    <div class="grain" aria-hidden="true"></div>
    <script>
      import { mountOcean } from '../scripts/ocean/mount';
      import { mountEditorial } from '../scripts/editorial';
      const content = document.querySelector<HTMLElement>('.deep-content');
      if (content) mountEditorial(content);
      const ocean = document.querySelector<HTMLElement>('.ocean');
      if (ocean) {
        // Decide the static layout before anchor placement when observation is unavailable.
        if (typeof IntersectionObserver === 'function') mountOcean(ocean);
        else ocean.dataset.scene = 'fallback';
      }
    </script>
  </body>
</html>
